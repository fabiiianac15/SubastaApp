NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/auction_app

# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor
JWT_EXPIRE=7d

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cada cuántos milisegundos se revisan aperturas y cierres de subastas
AUCTION_SWEEP_MS=30000
